<%@page contentType="application/vnd.ms-excel" pageEncoding="UTF-8"%>
<%@page import="com.mycompany.asset_management_system_ams.Department"%>
<%@page import="com.mycompany.asset_management_system_ams.DepartmentDAO"%>
<%@page import="java.util.List"%>
<%@page import="com.mycompany.asset_management_system_ams.RoleAccessUtil"%>
<%@page import="com.mycompany.asset_management_system_ams.HtmlEscapeUtil"%>
<%
    String username = (String) session.getAttribute("username");
    String role = (String) session.getAttribute("role");

    if (username == null || role == null) {
        response.sendRedirect("login.jsp");
        return;
    }

    boolean canExportDepartments = RoleAccessUtil.hasAccess(role, "DEPARTMENT_MANAGEMENT", "EXPORT");

    if (!canExportDepartments) {
        response.sendRedirect("departments.jsp?access=denied");
        return;
    }

    response.setHeader("Content-Disposition", "attachment; filename=\"departments_report_" + System.currentTimeMillis() + ".xls\"");
    
    List<Department> departments = DepartmentDAO.getAllDepartments();
%>
<html xmlns:x="urn:schemas-microsoft-com:office:excel">
<head>
    <meta charset="UTF-8">
    <style>
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid #000; padding: 5px; text-align: left; }
        th { background-color: #f2f2f2; font-weight: bold; }
    </style>
</head>
<body>
    <h3>Railway AMS - Departments Report</h3>
    <p>Generated by: <%= HtmlEscapeUtil.escape(username) %> (<%= HtmlEscapeUtil.escape(role) %>)</p>
    <table>
        <thead>
            <tr>
                <th>Department ID</th>
                <th>Department Code</th>
                <th>Department Name</th>
                <th>Description</th>
                <th>Department Head</th>
                <th>Status</th>
                <th>Total Assets</th>
                <th>Total Employees</th>
                <th>Created At</th>
                <th>Updated At</th>
            </tr>
        </thead>
        <tbody>
            <% for (Department d : departments) { %>
            <tr>
                <td><%= d.getDepartmentId() %></td>
                <td><%= HtmlEscapeUtil.escape(d.getDepartmentCode()) %></td>
                <td><%= HtmlEscapeUtil.escape(d.getDepartmentName()) %></td>
                <td><%= HtmlEscapeUtil.escape(d.getDescription()) %></td>
                <td><%= HtmlEscapeUtil.escape(d.getDepartmentHeadName()) %></td>
                <td><%= HtmlEscapeUtil.escape(d.getStatus()) %></td>
                <td><%= d.getAssetCount() %></td>
                <td><%= d.getEmployeeCount() %></td>
                <td><%= d.getCreatedAt() != null ? d.getCreatedAt().toString() : "" %></td>
                <td><%= d.getUpdatedAt() != null ? d.getUpdatedAt().toString() : "" %></td>
            </tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>
