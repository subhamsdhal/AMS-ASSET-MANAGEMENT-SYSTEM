<%@page contentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" pageEncoding="UTF-8"%>
<%@page import="com.mycompany.asset_management_system_ams.CategoryVendorMapping"%>
<%@page import="com.mycompany.asset_management_system_ams.CategoryVendorMappingDAO"%>
<%@page import="java.util.List"%>
<%@page import="java.time.LocalDateTime"%>
<%@page import="java.time.format.DateTimeFormatter"%>
<%@page import="org.apache.poi.ss.usermodel.Cell"%>
<%@page import="org.apache.poi.ss.usermodel.CellStyle"%>
<%@page import="org.apache.poi.ss.usermodel.FillPatternType"%>
<%@page import="org.apache.poi.ss.usermodel.Font"%>
<%@page import="org.apache.poi.ss.usermodel.HorizontalAlignment"%>
<%@page import="org.apache.poi.ss.usermodel.IndexedColors"%>
<%@page import="org.apache.poi.ss.usermodel.Row"%>
<%@page import="org.apache.poi.ss.usermodel.Sheet"%>
<%@page import="org.apache.poi.ss.usermodel.Workbook"%>
<%@page import="org.apache.poi.xssf.usermodel.XSSFWorkbook"%>

<%!
    private String safeCell(Object value) {
        if (value == null) {
            return "";
        }
        return String.valueOf(value);
    }
%>
<%
    String username = (String) session.getAttribute("username");
    String role = (String) session.getAttribute("role");

    if (username == null || role == null) {
        response.sendRedirect("login.jsp");
        return;
    }

    boolean canExport = ("SUPER_ADMIN".equals(role) || "ADMIN".equals(role))
            || "ASSET_MANAGER".equalsIgnoreCase(role)
            || "AUDITOR".equalsIgnoreCase(role);

    if (!canExport) {
        response.sendRedirect("access_denied.jsp");
        return;
    }

    response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate");
    response.setHeader("Pragma", "no-cache");
    response.setDateHeader("Expires", 0);
    response.setHeader("Content-Disposition", "attachment; filename=category_supplier_mapping_report.xlsx");

    CategoryVendorMappingDAO dao = new CategoryVendorMappingDAO();
    List<CategoryVendorMapping> mappings = dao.getAllMappings();

    try (Workbook workbook = new XSSFWorkbook()) {
        Sheet sheet = workbook.createSheet("Category Supplier Mapping");

        CellStyle titleStyle = workbook.createCellStyle();
        Font titleFont = workbook.createFont();
        titleFont.setBold(true);
        titleFont.setFontHeightInPoints((short) 16);
        titleStyle.setFont(titleFont);
        titleStyle.setAlignment(HorizontalAlignment.CENTER);

        CellStyle headerStyle = workbook.createCellStyle();
        Font headerFont = workbook.createFont();
        headerFont.setBold(true);
        headerFont.setColor(IndexedColors.WHITE.getIndex());
        headerStyle.setFont(headerFont);
        headerStyle.setFillForegroundColor(IndexedColors.DARK_BLUE.getIndex());
        headerStyle.setFillPattern(FillPatternType.SOLID_FOREGROUND);

        Row titleRow = sheet.createRow(0);
        Cell titleCell = titleRow.createCell(0);
        titleCell.setCellValue("IR-AMS Category Supplier Mapping Report");
        titleCell.setCellStyle(titleStyle);
        sheet.addMergedRegion(new org.apache.poi.ss.util.CellRangeAddress(0, 0, 0, 6));

        Row metaRow = sheet.createRow(1);
        metaRow.createCell(0).setCellValue("Generated By");
        metaRow.createCell(1).setCellValue(safeCell(username));
        metaRow.createCell(3).setCellValue("Generated On");
        metaRow.createCell(4).setCellValue(LocalDateTime.now().format(DateTimeFormatter.ofPattern("dd-MM-yyyy HH:mm:ss")));

        Row header = sheet.createRow(3);
        String[] columns = {
            "Mapping ID", "Category", "Supplier", "Status", "Linked Assets", "Created At", "Export Scope"
        };

        for (int i = 0; i < columns.length; i++) {
            Cell cell = header.createCell(i);
            cell.setCellValue(columns[i]);
            cell.setCellStyle(headerStyle);
        }

        int rowIndex = 4;
        for (CategoryVendorMapping mapping : mappings) {
            Row row = sheet.createRow(rowIndex++);
            row.createCell(0).setCellValue(mapping.getMappingId());
            row.createCell(1).setCellValue(safeCell(mapping.getCategoryName()));
            row.createCell(2).setCellValue(safeCell(mapping.getVendorName()));
            row.createCell(3).setCellValue(safeCell(mapping.getStatus()));
            row.createCell(4).setCellValue(mapping.getLinkedAssetCount());
            row.createCell(5).setCellValue(safeCell(mapping.getCreatedAt()));
            row.createCell(6).setCellValue("Live MySQL Data");
        }

        for (int i = 0; i < columns.length; i++) {
            sheet.autoSizeColumn(i);
        }

        sheet.createFreezePane(0, 4);
        workbook.write(response.getOutputStream());
    }
%>