# ============================================================
# Railway AMS — Environment Configuration Template (.env.example)
# Copy this file to .env or configure these in your deployment container / cloud platform.
# Never commit the actual .env file or production passwords to version control.
# ============================================================

# --- Database Connection (MySQL 8.0+ / Google Cloud SQL) ---
AMS_DB_URL=jdbc:mysql://localhost:3306/asset_management_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
AMS_DB_USER=ams_user
AMS_DB_PASSWORD=your_secure_db_password

# --- Application Security & AES Key ---
# 16, 24, or 32-character key for AES encryption of stored credentials
AMS_CRYPTO_KEY=Your16CharKey123!

# --- Storage Layer (Local or Google Cloud Storage) ---
# Supported values: LOCAL, GCS
AMS_STORAGE_PROVIDER=LOCAL
# Required if AMS_STORAGE_PROVIDER=GCS:
# GCS_BUCKET_NAME=your-ams-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- AI Copilot (Optional, can also be configured via Web Settings) ---
# Supported providers: GEMINI, OPENAI, CLAUDE, GROQ
# AMS_COPILOT_PROVIDER=GEMINI
# AMS_COPILOT_API_KEY=your_api_key_here

# --- Server Port (Default: 8080) ---
PORT=8080
