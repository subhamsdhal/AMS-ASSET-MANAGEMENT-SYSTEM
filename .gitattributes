# ============================================================
# .gitattributes — Normalization & Binary Handling
# ============================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows command and batch files require CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source code & configs
*.java text diff=java eol=lf
*.jsp text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.jar binary
*.war binary
*.zip binary
